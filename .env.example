# Telegram bot token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram chat ID для уведомлений (узнать через python get_chat_id.py)
TELEGRAM_CHAT_ID=your_chat_id_here

# Источник цен:
#   browser — парсинг Aviasales через headless-браузер (актуальные цены, по умолчанию)
#   api     — кэш Travelpayouts Data API (быстрее, но данные устаревают)
PRICE_SOURCE=browser

# Показывать окно браузера (для отладки парсинга). true — headless (по умолчанию)
MONITOR_HEADLESS=true

# Токен Travelpayouts Data API — нужен ТОЛЬКО при PRICE_SOURCE=api
TRAVELPAYOUTS_TOKEN=your_token_here
