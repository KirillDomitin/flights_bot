# Telegram bot token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram chat ID для уведомлений (узнать через python get_chat_id.py)
TELEGRAM_CHAT_ID=your_chat_id_here

# Источник цен:
#   browser — парсинг Aviasales через headless-браузер (актуальные цены, по умолчанию)
#   api     — кэш Travelpayouts Data API (быстрее, но данные устаревают)
PRICE_SOURCE=browser

# Показывать окно браузера (для отладки парсинга). true — headless (по умолчанию)
MONITOR_HEADLESS=true

# Токен Travelpayouts Data API — нужен ТОЛЬКО при PRICE_SOURCE=api
TRAVELPAYOUTS_TOKEN=your_token_here

# Кэш результатов запроса цены. В Docker задаётся автоматически (см. docker-compose.yml).
# Локально без Redis — оставь пустым, кэш просто выключится (прямые запросы).
REDIS_URL=
# Время жизни кэша в секундах (по умолчанию 900 = 15 мин)
CACHE_TTL_SECONDS=900

# Режим получения апдейтов от Telegram:
#   polling — long-polling, работает за NAT без публичного адреса (по умолчанию)
#   webhook — Telegram шлёт апдейты на публичный HTTPS (нужен ingress, напр. Cloudflare Tunnel)
BOT_MODE=polling
# --- Ниже нужно только при BOT_MODE=webhook ---
# Публичный HTTPS-адрес вебхука (включая путь). Путь берётся отсюда же.
# Пример: https://flights.example.com/<случайный-путь>
WEBHOOK_URL=
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (отсекает фейковые апдейты).
# Любая случайная строка (A-Z a-z 0-9 _ -), например: openssl rand -hex 32
WEBHOOK_SECRET=
# Порт встроенного webhook-сервера внутри контейнера (наружу не публикуется)
WEBHOOK_PORT=8443
